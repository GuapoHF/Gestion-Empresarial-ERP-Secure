# Variables de entorno y secretos (NUNCA confirmar en Git)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Certificados, llaves privadas y almacenes criptograficos
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks

# Dependencias Node.js
node_modules/
**/node_modules/

# Archivos de registro (logs) y diagnosticos
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Almacenamiento temporal de cargas de archivos
uploads/
**/uploads/
temp/
tmp/

# Archivos generados o del sistema operativo
.DS_Store
Thumbs.db
*.swp
