# Copia este archivo como .env. No confirmes .env en Git.
# Supabase > Project Settings > Database > Connection string > URI.
# Para un servidor persistente usa la conexion directa; para entornos serverless usa el pooler.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_SSL=true
DB_POOL_MAX=10
PORT=3000
NODE_ENV=development

# Obligatorio en produccion durante el primer arranque (retiralo tras crear el administrador).
# BOOTSTRAP_ADMIN_EMAIL=admin@tuempresa.com
# BOOTSTRAP_ADMIN_USERNAME=administrador
# BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-clave-123
