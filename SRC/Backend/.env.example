# ==============================================================================
# PLANTILLA DE CONFIGURACION SEGURA (.env.example)
# Copia este archivo como .env en SRC/Backend/.env. NUNCA confirmes .env en Git.
# ==============================================================================

NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FORCE_HTTPS=false

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS SUPABASE Y SEPARACION DE PRIVILEGIOS (Puntos 1, 3 y 13)
# ------------------------------------------------------------------------------
# En produccion usa un rol de aplicacion con privilegios minimos (ej. app_backend_user)
# en lugar del superusuario 'postgres'. Usa "local" para pruebas en memoria (pg-mem).
SUPABASE_DB_URL=postgresql://app_backend_user.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_APP_ROLE=app_backend_user
DB_SSL=true
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=15000
STATEMENT_TIMEOUT_MS=10000
SLOW_QUERY_THRESHOLD_MS=500

# Credenciales publicas de Supabase (restringidas por RLS para rol anon)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EXAMPLE_PUBLIC_ANON_KEY

# ------------------------------------------------------------------------------
# 2. CRIPTOGRAFIA Y PROTECCION DE DATOS EN REPOSO (Puntos 5 y 10)
# ------------------------------------------------------------------------------
# Clave de 32 bytes (64 caracteres hex) para cifrado AES-256-GCM de campos sensibles (CURP/RFC/DNI/RTN/NSS)
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DATA_HMAC_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Pimienta (Pepper) secreta de servidor para el hashing PBKDF2-HMAC-SHA512 de contrasenas
PASSWORD_PEPPER=reemplaza-este-secreto-pepper-en-produccion-987654321

# ------------------------------------------------------------------------------
# 3. PROTECCION ANTI-BOTS Y FUERZA BRUTA (Puntos 11 y 12)
# ------------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BOT_MIN_SUBMIT_TIME_MS=800
# Clave secreta de Cloudflare Turnstile / reCAPTCHA (opcional en desarrollo, recomendada en produccion)
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 4. ADMINISTRADOR INICIAL / BOOTSTRAP (Solo primer arranque)
# ------------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=administrador@vicmar.hn
BOOTSTRAP_ADMIN_USERNAME=administrador
BOOTSTRAP_ADMIN_PASSWORD=
